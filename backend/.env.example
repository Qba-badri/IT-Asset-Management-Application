# ========================================
# Database Configuration
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# IMPORTANT: Set a strong password! Never commit the actual .env file
DB_PASSWORD=your-strong-database-password-here
DB_NAME=IT Asset Management

# ========================================
# JWT Configuration
# ========================================
# CRITICAL: Generate a strong secret key for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-strong-random-secret-key-minimum-32-characters
JWT_EXPIRATION=1h

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ========================================
# Email Configuration (Optional)
# ========================================
# For Gmail, use App Passwords: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# ========================================
# Azure AD Configuration (Optional)
# ========================================
# Required for Azure AD authentication
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# ========================================
# File Upload Configuration
# ========================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ========================================
# Security Configuration
# ========================================
# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000
