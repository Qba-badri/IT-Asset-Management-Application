# ========================================
# Database Configuration
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# IMPORTANT: Set a strong password! Never commit the actual .env file
DB_PASSWORD=your-strong-database-password-here
DB_NAME=IT Asset Management
# Schema is managed by migrations (npm run migration:run).
# DB_SYNCHRONIZE=true is a local-development-only escape hatch; the app
# refuses to start with it outside NODE_ENV=development.
DB_SYNCHRONIZE=false

# ========================================
# JWT Configuration
# ========================================
# CRITICAL: Generate a strong secret key for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-strong-random-secret-key-minimum-32-characters
JWT_EXPIRATION=1h

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ========================================
# Email Configuration (Optional)
# ========================================
# For Gmail, use App Passwords: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# ========================================
# Integration Credentials (Optional)
# ========================================
# Azure AD and QPeople credentials can be configured at runtime from the
# Admin UI (Settings -> Integrations); values saved there are encrypted in
# the database and take precedence over these environment variables. The
# env vars below remain supported as a fallback/bootstrap mechanism.

# Azure AD user sync
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# QPeople HRMS user sync
QPEOPLE_API_URL=https://hr.yourdomain.com
QPEOPLE_API_TOKEN=your-qpeople-api-token

# Key used to encrypt integration credentials stored in the database
# (AES-256-GCM). Falls back to JWT_SECRET when unset. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this key makes previously saved credentials unreadable;
# re-enter them in Settings -> Integrations afterwards.
SETTINGS_ENCRYPTION_KEY=

# ========================================
# File Upload Configuration
# ========================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ========================================
# Security Configuration
# ========================================
# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000

# ========================================
# Validation rollout
# ========================================
# Controls rules marked @Observe in the DTOs — the mandatory-field backfill
# (see docs/mandatory-field-validation-design.md).
#
#   unset / false  Observed rules are RECORDED but NOT rejected. Every other
#                  validation rule is enforced exactly as normal.
#   true           Observed rules reject like any other rule.
#
# Leave this unset for at least one production release. Then review
# GET /validation/observations (needs settings.manage) to see which rules would
# have rejected traffic and from whom. Pay attention to `nonUiSuspects`: rows
# with no user id or a non-browser user-agent suggest a script or integration
# that would break on enforcement. Extend the window if any are found.
#
# Once reviewed and clean, set to true; after a release at true, delete the
# @Observe decorators so the rules become ordinary rules.
# VALIDATION_ENFORCE_OBSERVED=true

# ========================================
# Seeding (npm run seed)
# ========================================
# REQUIRED outside NODE_ENV=development. The seeded admin account uses these.
# Never use a shared or well-known password for UAT/production.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=set-a-unique-strong-password-before-seeding
